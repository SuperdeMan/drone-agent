    {
      "file": "docs/decisions.md",
      "bytes": 301912,
      "lines": 2057,
      "sha256": "c0fcedc3c32f21800751de7e052ccfd9df2f90adef26bdeaebf3e398c7549bc5",
      "review": "affected-current-or-dated-history",
      "relevant_lines": [
        {
          "line": 1557,
          "text": "常驻任务台暂不换用 change-v6，等目标业务评测集（WP-P6-01）再定。"
        },
        {
          "line": 2042,
          "text": "## D089 · 道路业务评测目标与独立资产计分（WP-P6-01）"
        },
        {
          "line": 2044,
          "text": "**日期**：2026-10-15 · **状态**：验收目标已由用户确认；数据清单、实际采集配对和正式测试尚未冻结，WP-P6-01 未准出。"
        },
        {
          "line": 2053,
          "text": "**D089 范围补记（2026-10-15）**：用户回复“按 S2 范围验收（建议）”，确认 WP-P6-01 按有人复核的道路障碍候选识别 S2 验收；原工作包未单列的现场清障效果移出本工作包关闭条件，仍明确报告为未验证。D089 的全部数值、样本量、独立性、真实跨次配对和人工计时要求不变。数据清单与模型正式运行尚未冻结，当前仍未准出。详细依据和范围见[道路业务评测实施](p6-business-evaluation.md#已确认的验收范围澄清)。"
        },
        {
          "line": 2055,
          "text": "**D089 标注流程补记（2026-10-16）**：用户明确采用“正式测试集也用独立 AI 预标后由我逐张核对”，授权修订标注协议并披露辅助来源，其他门槛不变。允许不继承实现上下文、未见评测提示 / 输出 / 源标签的独立标注 Agent 先生成草稿；真人逐张对照原图确认或修改后才形成 AI 辅助人工真值。草稿、分工隔离、图像、修改决定和真实标注时间必须可追溯；看到待评模型输出仍不准入正式测试，不伪称盲标，不把草稿和标注时间当成真人完成或候选复核耗时。详细流程见[道路评测实施](p6-business-evaluation.md#独立-ai-预标后人工核对2026-10-16-经用户确认)。"
        },
        {
          "line": 2057,
          "text": "**D089 AI 代行核验与运营计时拆分（2026-10-18）**：用户明确授权“不用真人逐张复核，你的复核可以代表人类”，并单独同意将真人候选处理用时“移至后续运营验证，继续完成本次验收”。标签制作改为独立 AI 初标与另一独立 AI 逐张核验，必须保留首稿、逐条改动、原图检查及隔离登记；只记 `delegated_ai` 参考标签，不伪造真人确认、强身份或真人用时。S2 报告披露 AI 参考真值的范围，真人 p95 / 数量 / 全覆盖计时目标保留为未验证的后续运营事项，不计作通过。其余 D089 质量、样本量、独立性、地点与真实跨次要求不变，开发曝光不得洗白；正式测试尚未冻结或执行，不能由协议修订推出 WP-P6-01 已关闭。详见[当前协议](p6-business-evaluation.md#当前有效的-ai-代行核验修订2026-10-18)。"
        }
      ]
    },
